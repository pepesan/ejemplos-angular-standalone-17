# Copia este fichero a backend/.env y ajusta lo que necesites. backend/.env no se versiona (contiene secretos locales).
# Una variable vacía cuenta como no definida: se usa el valor por defecto.

PORT=3001
HOST=127.0.0.1

# Secreto para firmar los JWT. Vacío = clave pública de desarrollo (el servidor avisa al arrancar).
JWT_SECRET=

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Registrar cada petición en consola: true o false.
LOG_REQUESTS=false

# Base de datos.
#   :memory:  (o vacío) → SQLite en memoria: los datos se pierden al parar el servidor.
#   ruta      → SQLite en fichero: los datos se conservan entre arranques.
DB_FILE=:memory:
# DB_FILE=./backend/data/usuarios.sqlite

# Cargar los usuarios de ejemplo si la tabla está vacía: true o false.
# En un fichero, solo se cargan la primera vez.
DB_SEED=true
