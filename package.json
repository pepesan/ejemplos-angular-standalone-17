{
  "name": "proyecto",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "backend": "node backend/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "fuentes": "node scripts/generar-fuentes-ejemplo.mjs",
    "test": "npm run test:unit",
    "test:unit": "ng test --watch=false",
    "test:unit:watch": "ng test",
    "test:unit:coverage": "ng test --watch=false --coverage",
    "test:stories": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:bdd": "start-server-and-test e2e:serve http://127.0.0.1:4300 cucumber-js",
    "e2e:serve": "ng serve --host 127.0.0.1 --port 4300 --proxy-config proxy.conf.json",
    "storybook": "ng run proyecto:storybook",
    "build-storybook": "ng run proyecto:build-storybook",
    "test:all": "npm run test:unit && npm run test:stories && npm run test:e2e && npm run test:bdd"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2202.6",
    "@angular-devkit/core": "^22.2.6",
    "@angular/animations": "^22.2.6",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/angular-vite": "^10.6.7",
    "@testing-library/angular": "^17.3.7",
    "@testing-library/dom": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
